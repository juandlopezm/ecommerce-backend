# Copia este archivo a .env y ajusta los valores

# Base de datos (PostgreSQL para desarrollo vía docker-compose)
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce

# Seguridad / JWT
JWT_SECRET=81052517b27794f91294f8dbbdda2c7f4db10a124567890abcdef 
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting del login (intentos por ventana)
LOGIN_RATE_LIMIT=5/minute

# Orígenes permitidos para CORS (JSON). El frontend Vite corre en :5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Regex opcional para orígenes dinámicos (p. ej. todos los despliegues de Vercel):
# CORS_ORIGIN_REGEX=https://ecommerce-frontend.*\.vercel\.app

# Credenciales del administrador inicial (usadas por `python -m app.seed`)
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrador

# sonar properties
SONAR_PROJECT_KEY=sqp_81052517b27794f91294f8dbbdda2c7f4db10a12
