# Copia este archivo a .env y ajusta los valores

# Base de datos (PostgreSQL para desarrollo vía docker-compose)
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce

# Seguridad / JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting del login (intentos por ventana)
LOGIN_RATE_LIMIT=5/minute

# Credenciales del administrador inicial (usadas por `python -m app.seed`)
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrador
